{
  "seed": 42,
  "data": {
    "input_path": "data/raw/NormanWeissman2019_filtered.h5ad",
    "output_dir": "data/processed/norman_v0_1",
    "report_path": "reports/preprocessing_summary.md"
  },
  "qc": {
    "require_good_coverage": true,
    "require_single_cell": true,
    "min_counts": 1000,
    "min_genes": 500,
    "max_percent_mito": 20.0
  },
  "normalization": {
    "target_sum": 10000.0
  },
  "hvg": {
    "n_top_genes": 2000,
    "min_train_cells": 50,
    "mean_bins": 20,
    "include_perturbation_genes": true
  },
  "splits": {
    "validation_fraction": 0.10,
    "test_fraction": 0.10,
    "schemes": ["seen", "unseen_combo", "unseen_gene"]
  }
}
